<color:#555555>   FK : id_paiement -> PAIEMENT ; id_etablissement -> ETABLISSEMENT ; id_staff_emetteur -> STAFF</color>
<color:#555555>   FK composites (+ id_etablissement) : id_paiement, id_staff_emetteur</color>
<color:#555555>   UNIQUE : (code_verification) ; (id_paiement) WHERE statut = 'VALIDE' ; (id_etablissement, numero)</color>

<b>ANNULATION_PAIEMENT</b> ( <u>id_annulation_paiement</u>, motif, statut, date_demande, date_decision,
