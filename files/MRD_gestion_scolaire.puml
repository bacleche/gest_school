<color:#555555>   UNIQUE : (id_etablissement, code) WHERE id_etablissement IS NOT NULL ; (code) WHERE id_etablissement IS NULL</color>

<b>PAIEMENT</b> ( <u>id_paiement</u>, numero, montant, date_paiement, canal,
        reference_externe, nom_payeur, telephone_payeur, statut, date_validation,
        observation, <b>#id_etablissement</b>, <b>#id_mode_paiement</b>, <b><i>#id_parent_payeur</i></b>, <b><i>#id_staff_enregistreur</i></b>,
        <b><i>#id_transaction_en_ligne</i></b>, <b><i>#id_staff_validateur</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_mode_paiement -> MODE_PAIEMENT ; id_parent_payeur -> PARENT ; id_staff_enregistreur -> STAFF ; id_transaction_en_ligne -> TRANSACTION_EN_LIGNE ; id_staff_validateur -> STAFF</color>
<color:#555555>   FK composites (+ id_etablissement) : id_staff_enregistreur, id_staff_validateur, id_transaction_en_ligne</color>
<color:#555555>   UNIQUE : (id_transaction_en_ligne) ; (id_etablissement, numero)</color>

<b>ALLOCATION_PAIEMENT</b> ( <u>id_allocation_paiement</u>, montant_alloue, date_allocation, <b>#id_etablissement</b>, <b>#id_paiement</b>,
        <b>#id_creance</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_paiement -> PAIEMENT ; id_creance -> CREANCE</color>
<color:#555555>   FK composites (+ id_etablissement) : id_paiement, id_creance</color>
<color:#555555>   UNIQUE : (id_paiement, id_creance)</color>

<b>RECU</b> ( <u>id_recu</u>, numero, nom_payeur, montant, devise,
        detail, code_verification, date_emission, fichier, statut,
