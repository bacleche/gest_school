<b>CREANCE</b> ( <u>id_creance</u>, montant_du, remise, remise_reduction, motif_remise,
        statut, date_creation, <b>#id_etablissement</b>, <b>#id_inscription</b>, <b>#id_echeance</b>,
        <b><i>#id_staff_remise</i></b>, <b><i>#id_regle_reduction</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_inscription -> INSCRIPTION ; id_echeance -> ECHEANCE ; id_staff_remise -> STAFF ; id_regle_reduction -> REGLE_REDUCTION</color>
<color:#555555>   FK composites (+ id_etablissement) : id_inscription, id_echeance, id_staff_remise, id_regle_reduction</color>
<color:#555555>   UNIQUE : (id_inscription, id_echeance)</color>

<b>MODE_PAIEMENT</b> ( <u>id_mode_paiement</u>, code, libelle, est_actif, <b><i>#id_etablissement</i></b>,
        <b><i>#id_fournisseur_paiement</i></b> )
