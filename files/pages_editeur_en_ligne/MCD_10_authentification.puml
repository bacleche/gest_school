@startuml MCD_10_authentification
title MCD - 10 - Authentification, sessions et carte eleve
skinparam shadowing false
skinparam defaultFontName Arial
skinparam roundCorner 6
skinparam ArrowColor #34495E
skinparam titleFontSize 18
skinparam nodesep 60
skinparam ranksep 90
scale max 4000 width
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #8FA3BF
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F3A5F
  HeaderBackgroundColor #DCE9F7
  BackgroundColor<<ASSOCIATION>> #FFF3CD
  BorderColor<<ASSOCIATION>> #B8860B
  BackgroundColor<<externe>> #EEEEEE
  BorderColor<<externe>> #999999
}
hide circle
hide methods

class "APPAREIL_CONFIANCE" as APPAREIL_CONFIANCE {
  <u>id_appareil_confiance</u>
  --
  empreinte_appareil
  nom_appareil
  date_ajout
  derniere_utilisation
  date_expiration
  date_revocation
}
class "SESSION_UTILISATEUR" as SESSION_UTILISATEUR {
  <u>id_session_utilisateur</u>
  --
  role_actif
  empreinte_jeton
  adresse_ip
  agent_utilisateur
  date_creation
  date_expiration
  derniere_activite
  date_revocation
}
class "CODE_VERIFICATION" as CODE_VERIFICATION {
  <u>id_code_verification</u>
  --
  canal
  objet
  destination
  empreinte_code
  tentatives
  date_creation
  date_expiration
  date_utilisation
}
class "CARTE_ELEVE" as CARTE_ELEVE {
  <u>id_carte_eleve</u>
  --
  numero_carte
  empreinte_jeton_qr
  date_emission
  date_expiration
  statut
  fichier
  motif_revocation
}
class "UTILISATEUR" as UTILISATEUR <<externe>> {
  <u>id_utilisateur</u>
}
class "ETABLISSEMENT" as ETABLISSEMENT <<externe>> {
  <u>id_etablissement</u>
}
class "ELEVE" as ELEVE <<externe>> {
  <u>id_eleve</u>
}
class "INSCRIPTION" as INSCRIPTION <<externe>> {
  <u>id_inscription</u>
}
class "DOCUMENT" as DOCUMENT <<externe>> {
  <u>id_document</u>
}
APPAREIL_CONFIANCE "1,1" -- "0,n" UTILISATEUR : APPARTENIR_A_UTILISATEUR
SESSION_UTILISATEUR "1,1" -- "0,n" UTILISATEUR : OUVRIR_SESSION
SESSION_UTILISATEUR "0,1" -- "0,n" APPAREIL_CONFIANCE : PROVENIR_DE_APPAREIL
SESSION_UTILISATEUR "0,1" -- "0,n" ETABLISSEMENT : AVOIR_POUR_CONTEXTE
CODE_VERIFICATION "1,1" -- "0,n" UTILISATEUR : ETRE_ENVOYE_A
CARTE_ELEVE "1,1" -- "0,n" ELEVE : IDENTIFIER_ELEVE
CARTE_ELEVE "1,1" -- "0,n" INSCRIPTION : VALOIR_POUR
CARTE_ELEVE "0,1" -- "0,1" DOCUMENT : ETRE_ARCHIVEE_DANS
legend bottom
  Notation Merise : la cardinalite (min,max) placee pres d'une entite indique
  combien de fois UNE occurrence de cette entite participe a l'association.
  <u>identifiant</u> souligne | entite grise = entite d'un autre domaine (rappel)
  Boite jaune = association porteuse de proprietes (devient une table au MLD)
  Association n,n sans boite (ex. COMPOSER) = table de jonction au MLD
  INSCRIPTION, ENSEIGNEMENT, NOTE, CREANCE, ATTRIBUTION_* : entites-associations dotees
  d'un identifiant propre car referencees par d'autres entites ou historisees
  Isolation : au MLD, chaque table d'un etablissement recoit id_etablissement (non represente ici)
endlegend

@enduml
