' ============================================================
' MLD - SYSTEME DE GESTION SCOLAIRE (PlantUML, diagramme ER)
' Modele logique relationnel avec types, PK, FK, contraintes.
' 11 pages : vue d'ensemble + 10 domaines fonctionnels.
' Rendu conseille : plantuml -tsvg (ou PLANTUML_LIMIT_SIZE=16384 pour PNG)
' ============================================================
@startuml MLD_00_vue_ensemble
title MLD - Vue d'ensemble (cles uniquement)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam roundCorner 6
skinparam ArrowColor #34495E
skinparam titleFontSize 18
' Vue d'ensemble compacte : sinon l'image depasse 4096 px et l'editeur la coupe
skinparam nodesep 25
skinparam ranksep 50
scale max 4000 width
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #8FA3BF
}
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #1F3A5F
  BackgroundColor<<externe>> #EEEEEE
  BorderColor<<externe>> #999999
}
hide methods

