' ============================================================
' MRD - MODELE RELATIONNEL (notation textuelle) - GESTION SCOLAIRE
' 10 pages (une par domaine) - 72 relations.
' Derive du MLD : toute modification doit etre reportee dans les deux fichiers.
' ============================================================
@startuml MRD_01_noyau
title MRD - 1 - Noyau, comptes et permissions
skinparam shadowing false
skinparam defaultFontName Courier
note as N
<b>ETABLISSEMENT</b> ( <u>id_etablissement</u>, code, nom, type_etablissement, adresse,
        ville, pays, telephone, email, logo,
        devise, est_actif, date_creation )
<color:#555555>   UNIQUE : (code)</color>

<b>UTILISATEUR</b> ( <u>id_utilisateur</u>, email, mot_de_passe_hash, nom, prenom,
        telephone, identifiant, photo, est_admin_systeme, statut_compte,
        derniere_connexion, tentatives_echec, verrouille_jusqu_a, date_changement_mdp, telephone_verifie_le,
        email_verifie_le, doit_changer_mdp, type_secret, methode_2fa, reference_secret_2fa,
        canal_notification_prefere, date_anonymisation, date_creation )
<color:#555555>   UNIQUE : (identifiant) ; (telephone) ; (email)</color>

<b>STAFF</b> ( <u>id_staff</u>, type_staff, matricule, fonction, specialite,
        date_embauche, date_fin, statut, date_creation, <b>#id_utilisateur</b>,
        <b>#id_etablissement</b>, <b><i>#id_staff_createur</i></b> )
<color:#555555>   FK : id_utilisateur -> UTILISATEUR ; id_etablissement -> ETABLISSEMENT ; id_staff_createur -> STAFF</color>
<color:#555555>   FK composites (+ id_etablissement) : id_staff_createur</color>
<color:#555555>   UNIQUE : (id_etablissement, matricule) ; (id_utilisateur, id_etablissement)</color>

<b>DOMAINE</b> ( <u>id_domaine</u>, code, libelle, description )
<color:#555555>   UNIQUE : (code)</color>

<b>TYPE_ACTION</b> ( <u>id_type_action</u>, code, libelle, categorie )
<color:#555555>   UNIQUE : (code)</color>

<b>PERMISSION</b> ( <u>id_permission</u>, code, libelle, ressource, description,
        <b>#id_domaine</b>, <b>#id_type_action</b> )
<color:#555555>   FK : id_domaine -> DOMAINE ; id_type_action -> TYPE_ACTION</color>
<color:#555555>   UNIQUE : (code)</color>

<b>ATTRIBUTION_PERMISSION</b> ( <u>id_attribution_permission</u>, date_attribution, date_expiration, est_active, <b>#id_etablissement</b>,
        <b>#id_staff_beneficiaire</b>, <b>#id_permission</b>, <b>#id_staff_attribuant</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_staff_beneficiaire -> STAFF ; id_permission -> PERMISSION ; id_staff_attribuant -> STAFF</color>
<color:#555555>   FK composites (+ id_etablissement) : id_staff_beneficiaire, id_staff_attribuant</color>
<color:#555555>   UNIQUE : (id_staff_beneficiaire, id_permission) WHERE est_active = TRUE</color>

<b>ROLE</b> ( <u>id_role</u>, code, libelle, description, est_actif,
        <b><i>#id_etablissement</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT</color>
<color:#555555>   UNIQUE : (id_etablissement, code) WHERE id_etablissement IS NOT NULL ; (code) WHERE id_etablissement IS NULL</color>

<b>ROLE_PERMISSION</b> ( <u>id_role_permission</u>, <b>#id_role</b>, <b>#id_permission</b> )
<color:#555555>   FK : id_role -> ROLE ; id_permission -> PERMISSION</color>
<color:#555555>   UNIQUE : (id_role, id_permission)</color>

<b>ATTRIBUTION_ROLE</b> ( <u>id_attribution_role</u>, date_attribution, date_expiration, est_active, <b>#id_etablissement</b>,
        <b>#id_staff_beneficiaire</b>, <b>#id_role</b>, <b>#id_staff_attribuant</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_staff_beneficiaire -> STAFF ; id_role -> ROLE ; id_staff_attribuant -> STAFF</color>
<color:#555555>   FK composites (+ id_etablissement) : id_staff_beneficiaire, id_staff_attribuant</color>
<color:#555555>   UNIQUE : (id_staff_beneficiaire, id_role) WHERE est_active = TRUE</color>
end note
legend bottom
  Notation : TABLE ( <u>cle_primaire</u>, attributs, <b>#cle_etrangere</b> )
  <b><i>#cle_etrangere</i></b> en italique = FK facultative (NULL autorise)
  Chaque table liste ses FK (colonne -> table referencee) et ses contraintes UNIQUE.
  UNIQUE ... WHERE = index unique partiel. Regles CHECK, triggers et RLS : voir le MLD.
  FK composites : la FK inclut id_etablissement (isolation entre etablissements).
endlegend
@enduml
@startuml MRD_02_academique
title MRD - 2 - Structure academique et emploi du temps
skinparam shadowing false
skinparam defaultFontName Courier
note as N
<b>ANNEE_SCOLAIRE</b> ( <u>id_annee_scolaire</u>, libelle, date_debut, date_fin, statut,
        <b>#id_etablissement</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT</color>
<color:#555555>   UNIQUE : (id_etablissement, libelle) ; (id_etablissement) WHERE statut = 'EN_COURS'</color>

<b>PERIODE</b> ( <u>id_periode</u>, libelle, numero, date_debut, date_fin,
        statut, <b>#id_etablissement</b>, <b>#id_annee_scolaire</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_annee_scolaire -> ANNEE_SCOLAIRE</color>
<color:#555555>   FK composites (+ id_etablissement) : id_annee_scolaire</color>
<color:#555555>   UNIQUE : (id_annee_scolaire, numero) ; (id_annee_scolaire) WHERE statut = 'EN_COURS'</color>

<b>NIVEAU</b> ( <u>id_niveau</u>, code, libelle, cycle, ordre,
        <b>#id_etablissement</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT</color>
<color:#555555>   UNIQUE : (id_etablissement, code)</color>

<b>CLASSE</b> ( <u>id_classe</u>, nom, effectif_max, statut, <b>#id_etablissement</b>,
        <b>#id_annee_scolaire</b>, <b>#id_niveau</b>, <b><i>#id_staff_titulaire</i></b>, <b><i>#id_salle</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_annee_scolaire -> ANNEE_SCOLAIRE ; id_niveau -> NIVEAU ; id_staff_titulaire -> STAFF ; id_salle -> SALLE</color>
<color:#555555>   FK composites (+ id_etablissement) : id_annee_scolaire, id_niveau, id_staff_titulaire, id_salle</color>
<color:#555555>   UNIQUE : (id_annee_scolaire, nom) ; (id_classe, id_annee_scolaire) (cible de la FK composite d'INSCRIPTION)</color>

<b>MATIERE</b> ( <u>id_matiere</u>, code, libelle, description, est_active,
        <b>#id_etablissement</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT</color>
<color:#555555>   UNIQUE : (id_etablissement, code)</color>

<b>ENSEIGNEMENT</b> ( <u>id_enseignement</u>, coefficient, volume_horaire_hebdo, date_debut, date_fin,
        statut, <b>#id_etablissement</b>, <b>#id_classe</b>, <b>#id_matiere</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_classe -> CLASSE ; id_matiere -> MATIERE</color>
<color:#555555>   FK composites (+ id_etablissement) : id_classe, id_matiere</color>
<color:#555555>   UNIQUE : (id_classe, id_matiere)</color>

<b>CRENEAU</b> ( <u>id_creneau</u>, jour_semaine, heure_debut, heure_fin, date_debut,
        date_fin, <b>#id_etablissement</b>, <b>#id_enseignement</b>, <b><i>#id_salle</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_enseignement -> ENSEIGNEMENT ; id_salle -> SALLE</color>
<color:#555555>   FK composites (+ id_etablissement) : id_enseignement, id_salle</color>
<color:#555555>   UNIQUE : (id_enseignement, jour_semaine, heure_debut, date_debut)</color>

<b>AFFECTATION_ENSEIGNANT</b> ( <u>id_affectation_enseignant</u>, type_affectation, date_debut, date_fin, motif,
        <b>#id_etablissement</b>, <b>#id_enseignement</b>, <b>#id_staff_enseignant</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_enseignement -> ENSEIGNEMENT ; id_staff_enseignant -> STAFF</color>
<color:#555555>   FK composites (+ id_etablissement) : id_enseignement, id_staff_enseignant</color>

<b>SALLE</b> ( <u>id_salle</u>, code, libelle, capacite, est_active,
        <b>#id_etablissement</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT</color>
<color:#555555>   UNIQUE : (id_etablissement, code)</color>
end note
legend bottom
  Notation : TABLE ( <u>cle_primaire</u>, attributs, <b>#cle_etrangere</b> )
  <b><i>#cle_etrangere</i></b> en italique = FK facultative (NULL autorise)
  Chaque table liste ses FK (colonne -> table referencee) et ses contraintes UNIQUE.
  UNIQUE ... WHERE = index unique partiel. Regles CHECK, triggers et RLS : voir le MLD.
  FK composites : la FK inclut id_etablissement (isolation entre etablissements).
endlegend
@enduml
@startuml MRD_03_scolarite
title MRD - 3 - Secretariat : eleves, parents, inscriptions, documents
skinparam shadowing false
skinparam defaultFontName Courier
note as N
<b>PARENT</b> ( <u>id_parent</u>, profession, employeur, adresse, telephone_secondaire,
        date_creation, <b>#id_utilisateur</b> )
<color:#555555>   FK : id_utilisateur -> UTILISATEUR</color>
<color:#555555>   UNIQUE : (id_utilisateur)</color>

<b>ELEVE</b> ( <u>id_eleve</u>, matricule, nom, prenom, sexe,
        date_naissance, lieu_naissance, nationalite, adresse, photo,
        consentement_photo, date_consentement_photo, date_anonymisation, statut, date_creation,
        <b>#id_etablissement</b>, <b><i>#id_utilisateur</i></b>, <b><i>#id_famille</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_utilisateur -> UTILISATEUR ; id_famille -> FAMILLE</color>
<color:#555555>   FK composites (+ id_etablissement) : id_famille</color>
<color:#555555>   UNIQUE : (id_etablissement, matricule) ; (id_utilisateur, id_etablissement)</color>

<b>ELEVE_PARENT</b> ( <u>id_eleve_parent</u>, type_lien, est_responsable_legal, est_responsable_financier, est_contact_urgence,
        peut_consulter, date_debut, date_fin, <b>#id_etablissement</b>, <b>#id_eleve</b>,
        <b>#id_parent</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_eleve -> ELEVE ; id_parent -> PARENT</color>
<color:#555555>   FK composites (+ id_etablissement) : id_eleve</color>
<color:#555555>   UNIQUE : (id_eleve, id_parent)</color>

<b>INSCRIPTION</b> ( <u>id_inscription</u>, date_inscription, type_inscription, statut, date_validation,
        observation, <b>#id_etablissement</b>, <b>#id_eleve</b>, <b>#id_classe</b>, <b>#id_annee_scolaire</b>,
        <b>#id_staff_createur</b>, <b><i>#id_staff_validateur</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_eleve -> ELEVE ; id_classe -> CLASSE ; id_annee_scolaire -> ANNEE_SCOLAIRE ; id_staff_createur -> STAFF ; id_staff_validateur -> STAFF ; (id_classe, id_annee_scolaire) -> CLASSE (id_classe, id_annee_scolaire)</color>
<color:#555555>   FK composites (+ id_etablissement) : id_eleve, id_classe, id_annee_scolaire, id_staff_createur, id_staff_validateur</color>
<color:#555555>   UNIQUE : (id_eleve, id_annee_scolaire) WHERE statut IN ('EN_ATTENTE','VALIDEE')</color>

<b>TYPE_DOCUMENT</b> ( <u>id_type_document</u>, code, libelle, genere_automatiquement, <b><i>#id_etablissement</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT</color>
<color:#555555>   UNIQUE : (id_etablissement, code) WHERE id_etablissement IS NOT NULL ; (code) WHERE id_etablissement IS NULL</color>

<b>DOCUMENT</b> ( <u>id_document</u>, titre, fichier, date_document, visible_parent,
        visible_eleve, statut, date_creation, <b>#id_etablissement</b>, <b>#id_eleve</b>,
        <b>#id_type_document</b>, <b><i>#id_staff_auteur</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_eleve -> ELEVE ; id_type_document -> TYPE_DOCUMENT ; id_staff_auteur -> STAFF</color>
<color:#555555>   FK composites (+ id_etablissement) : id_eleve, id_staff_auteur</color>

<b>FAMILLE</b> ( <u>id_famille</u>, nom, date_creation, <b>#id_etablissement</b>, <b><i>#id_parent_referent</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_parent_referent -> PARENT</color>
end note
legend bottom
  Notation : TABLE ( <u>cle_primaire</u>, attributs, <b>#cle_etrangere</b> )
  <b><i>#cle_etrangere</i></b> en italique = FK facultative (NULL autorise)
  Chaque table liste ses FK (colonne -> table referencee) et ses contraintes UNIQUE.
  UNIQUE ... WHERE = index unique partiel. Regles CHECK, triggers et RLS : voir le MLD.
  FK composites : la FK inclut id_etablissement (isolation entre etablissements).
endlegend
@enduml
@startuml MRD_04_evaluation
title MRD - 4 - Responsabilite pedagogique : evaluations et resultats
skinparam shadowing false
skinparam defaultFontName Courier
note as N
<b>TYPE_EVALUATION</b> ( <u>id_type_evaluation</u>, code, libelle, coefficient_defaut, <b><i>#id_etablissement</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT</color>
<color:#555555>   UNIQUE : (id_etablissement, code) WHERE id_etablissement IS NOT NULL ; (code) WHERE id_etablissement IS NULL</color>

<b>EVALUATION</b> ( <u>id_evaluation</u>, titre, date_evaluation, note_maximale, coefficient,
        statut, date_validation, date_creation, <b>#id_etablissement</b>, <b>#id_enseignement</b>,
        <b>#id_periode</b>, <b>#id_type_evaluation</b>, <b>#id_staff_createur</b>, <b><i>#id_staff_validateur</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_enseignement -> ENSEIGNEMENT ; id_periode -> PERIODE ; id_type_evaluation -> TYPE_EVALUATION ; id_staff_createur -> STAFF ; id_staff_validateur -> STAFF</color>
<color:#555555>   FK composites (+ id_etablissement) : id_enseignement, id_periode, id_staff_createur, id_staff_validateur</color>

<b>NOTE</b> ( <u>id_note</u>, valeur, statut_note, observation, date_saisie,
        date_modification, <b>#id_etablissement</b>, <b>#id_evaluation</b>, <b>#id_inscription</b>, <b>#id_staff_saisie</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_evaluation -> EVALUATION ; id_inscription -> INSCRIPTION ; id_staff_saisie -> STAFF</color>
<color:#555555>   FK composites (+ id_etablissement) : id_evaluation, id_inscription, id_staff_saisie</color>
<color:#555555>   UNIQUE : (id_evaluation, id_inscription)</color>

<b>HISTORIQUE_NOTE</b> ( <u>id_historique_note</u>, type_operation, ancienne_valeur, nouvelle_valeur, motif,
        date_modification, <b>#id_etablissement</b>, <b>#id_note</b>, <b>#id_staff_modificateur</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_note -> NOTE ; id_staff_modificateur -> STAFF</color>
<color:#555555>   FK composites (+ id_etablissement) : id_note, id_staff_modificateur</color>

<b>RESULTAT_MATIERE</b> ( <u>id_resultat_matiere</u>, moyenne, rang, appreciation, statut,
        date_calcul, <b>#id_etablissement</b>, <b>#id_inscription</b>, <b>#id_enseignement</b>, <b>#id_periode</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_inscription -> INSCRIPTION ; id_enseignement -> ENSEIGNEMENT ; id_periode -> PERIODE</color>
<color:#555555>   FK composites (+ id_etablissement) : id_inscription, id_enseignement, id_periode</color>
<color:#555555>   UNIQUE : (id_inscription, id_enseignement, id_periode)</color>

<b>RESULTAT_PERIODE</b> ( <u>id_resultat_periode</u>, moyenne_generale, rang, mention, appreciation_generale,
        statut, date_validation, <b>#id_etablissement</b>, <b>#id_inscription</b>, <b>#id_periode</b>,
        <b><i>#id_staff_validateur</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_inscription -> INSCRIPTION ; id_periode -> PERIODE ; id_staff_validateur -> STAFF</color>
<color:#555555>   FK composites (+ id_etablissement) : id_inscription, id_periode, id_staff_validateur</color>
<color:#555555>   UNIQUE : (id_inscription, id_periode)</color>

<b>RESULTAT_ANNUEL</b> ( <u>id_resultat_annuel</u>, moyenne_annuelle, rang, decision, appreciation,
        statut, date_deliberation, <b>#id_etablissement</b>, <b>#id_inscription</b>, <b><i>#id_niveau_propose</i></b>,
        <b><i>#id_staff_validateur</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_inscription -> INSCRIPTION ; id_niveau_propose -> NIVEAU ; id_staff_validateur -> STAFF</color>
<color:#555555>   FK composites (+ id_etablissement) : id_inscription, id_niveau_propose, id_staff_validateur</color>
<color:#555555>   UNIQUE : (id_inscription)</color>

<b>DEROGATION_ACCES_RESULTAT</b> ( <u>id_derogation_acces_resultat</u>, motif, date_accord, date_fin_validite, est_active,
        <b>#id_etablissement</b>, <b>#id_inscription</b>, <b><i>#id_periode</i></b>, <b>#id_staff_accordant</b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_inscription -> INSCRIPTION ; id_periode -> PERIODE ; id_staff_accordant -> STAFF</color>
<color:#555555>   FK composites (+ id_etablissement) : id_inscription, id_periode, id_staff_accordant</color>
<color:#555555>   UNIQUE : (id_inscription, id_periode) WHERE est_active AND id_periode IS NOT NULL ; (id_inscription) WHERE est_active AND id_periode IS NULL</color>
end note
