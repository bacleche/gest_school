' ============================================================
' MCD - SYSTEME DE GESTION SCOLAIRE (notation Merise / PlantUML)
' 11 pages : vue d'ensemble + 10 domaines fonctionnels.
' Generer (recommande, sans limite de taille) : plantuml -tsvg MCD_gestion_scolaire.puml
' ============================================================
@startuml MCD_00_vue_ensemble
title MCD - Vue d'ensemble (toutes les entites)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam roundCorner 6
skinparam ArrowColor #34495E
skinparam titleFontSize 18
' Vue d'ensemble compacte : sinon l'image depasse 4096 px et l'editeur la coupe
skinparam nodesep 25
skinparam ranksep 50
scale max 4000 width
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #8FA3BF
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F3A5F
