<color:#555555>   UNIQUE : (id_paiement) WHERE statut IN ('DEMANDEE','APPROUVEE')</color>

<b>REGLE_REDUCTION</b> ( <u>id_regle_reduction</u>, libelle, type_reduction, rang_enfant_min, mode_calcul,
        valeur, est_active, <b>#id_etablissement</b>, <b>#id_annee_scolaire</b>, <b><i>#id_frais_scolaire</i></b> )
<color:#555555>   FK : id_etablissement -> ETABLISSEMENT ; id_annee_scolaire -> ANNEE_SCOLAIRE ; id_frais_scolaire -> FRAIS_SCOLAIRE</color>
<color:#555555>   FK composites (+ id_etablissement) : id_annee_scolaire, id_frais_scolaire</color>
end note
