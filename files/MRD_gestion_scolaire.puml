<color:#555555>   UNIQUE : (id_annee_scolaire, id_niveau, code) WHERE id_niveau IS NOT NULL ; (id_annee_scolaire, code) WHERE id_niveau IS NULL</color>

<b>ECHEANCE</b> ( <u>id_echeance</u>, libelle, date_limite, montant, mois_concerne,
